{
  "manifest_version": 3,
  "name": "Element Print",
  "version": "1.0.0",
  "description": "选取网页元素，抓取富文本，按报纸/杂志版式预览、打印或导出 HTML。",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Element Print · 选取元素",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
