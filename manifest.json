{
  "manifest_version": 3,
  "name": "Element Print",
  "version": "1.1.0",
  "description": "选取网页元素或整页正文，提取富文本，按报纸、学术期刊、公文版式预览、双语对照、打印或导出单文件 HTML。",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "contextMenus"],
  "host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://fanyi-api.baidu.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Element Print · 选取元素",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
